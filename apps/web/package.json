{
  "name": "@mule/web",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "vite build && pnpm run e2e:core && pnpm run e2e:regression",
    "e2e:core": "tsx e2e/smoke.ts",
    "e2e:regression": "tsx e2e/shell.ts && tsx e2e/lobby.ts && tsx e2e/specials.ts && tsx e2e/auction-steps.ts",
    "screens": "vite build && tsx e2e/screens.ts"
  },
  "dependencies": {
    "@mule/engine": "workspace:*",
    "@mule/protocol": "workspace:*",
    "@mule/ui": "workspace:*",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "1.56.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.1.10",
    "vitest": "^3.2.0"
  }
}
