+++ b/packages/engine/src/m23.ts
@@ -0,0 +1,17 @@
+// M23 throwaway prototype: GD (every commissioned project's missing goods in monthlyDemand) + the AI Governor's
+// commission factor f from M23_F (commission when the fund holds credits x f). maxOpen, grant, needsPlot and E-free
+// are set at runtime by the harness. Never merged.
+import { PRESTIGE } from './config.js';
+export const M23_F: number = Number((globalThis as any).process?.env?.M23_F ?? '1');
+/** Every commissioned project's still-missing goods, summed. */
+export function m23Missing(state: any): Record<string, number> {
+  const out: Record<string, number> = {};
+  for (const p of state.colony?.projects ?? []) {
+    if (p.stage !== 'commissioned') continue;
+    for (const [g, u] of Object.entries((PRESTIGE as any)[p.id].goods) as [string, number][]) {
+      const left = u - (p.funded.goods[g] ?? 0);
+      if (left > 0) out[g] = (out[g] ?? 0) + left;
+    }
+  }
+  return out;
+}
