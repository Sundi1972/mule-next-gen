--- /dev/null
+++ b/packages/engine/src/m24.ts
@@ -0,0 +1,16 @@
+// M24 throwaway prototype: GD (commissioned projects' missing goods in monthlyDemand), the AI Governor commissions at
+// 25% of credits, and M24_T2=1 (raise the tax by maxStep while a commissioned project lacks credits). E-free, maxOpen 2,
+// grant 450, T1 and T3 are set at runtime by the harness. Never merged.
+import { PRESTIGE } from './config.js';
+export const M24_T2: boolean = (globalThis as any).process?.env?.M24_T2 === '1';
+export function m24Missing(state: any): Record<string, number> {
+  const out: Record<string, number> = {};
+  for (const p of state.colony?.projects ?? []) {
+    if (p.stage !== 'commissioned') continue;
+    for (const [g, u] of Object.entries((PRESTIGE as any)[p.id].goods) as [string, number][]) {
+      const left = u - (p.funded.goods[g] ?? 0);
+      if (left > 0) out[g] = (out[g] ?? 0) + left;
+    }
+  }
+  return out;
+}
